{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/internal/purge-deleted-media",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/process-media",
      "schedule": "30 3 * * *"
    }
  ]
}
